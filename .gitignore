# =========================
# Release-safe repository scope
# =========================

# Keep only the Vietnamese translation patch tree from game/
game/**
!game/tl/
!game/tl/vietnamese/
!game/tl/vietnamese/**/*.rpy

# Ren'Py runtime / original content
renpy/
lib/
update/
oregairuzokupc.py
game/add_assets/
game/scripts/
game/cache/
game/saves/
game/*.save
game/*.rpyc
game/**/*.rpyc
game/*.rpa
game/**/*.rpa
game/*.exe
game/script.rpy
game/utilities.rpy
game/zz_vietnamese.rpy
game/script_version.txt
game/presplash_*.png

# Build outputs and binaries
*.exe
*.dll
*.zip
*.tar.gz
*.7z
build/
dist/

# Translation workflow logs and diagnostics
log.txt
errors.txt
traceback.txt
*.log
*.tmp
*.bak

# Screenshots
screenshot*.png
screenshots/

# Python cache / virtualenvs
__pycache__/
*.py[cod]
.venv/
venv/
env/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.hypothesis/
.cache/

# OS noise
Thumbs.db
Desktop.ini
.DS_Store

# IDE
.vscode/
.idea/